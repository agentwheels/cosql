{
  "name": "dbops",
  "version": "0.1.0",
  "description": "Safe PostgreSQL/MySQL ops CLI: agents can read freely and propose writes, only sudo-elevated humans can apply them.",
  "author": {
    "name": "xumingyuan"
  },
  "repository": "https://github.com/oriengy/dbops",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/install.sh"
          }
        ]
      }
    ]
  }
}
